# ─────────────────────────────────────────────────────────────────────────────
# Vercel-side env vars consumed by frondend/api/assessment/[id]/[phase].js
# These are SERVER-side ONLY (no VITE_ prefix) so they never leak to the
# browser bundle. Set them in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Where the FastAPI backend is hosted (no trailing slash).
ASSESSMENT_BACKEND_URL=https://your-api-domain.example.com

# Same value as API_SECRET_KEY on the backend; used by the proxy to call
# /api/v1/courseware-assessments/...
ASSESSMENT_API_KEY=replace-with-the-backend-API_SECRET_KEY

# Optional: upstream timeout in ms (default 110000). Pro/Enterprise Vercel
# plans support longer function durations than Hobby.
#ASSESSMENT_UPSTREAM_TIMEOUT_MS=110000
